<%# ホームの「感想を書いていないもの」の1行 %>
<article class="flex items-center gap-3 rounded-2xl border border-slate-200 bg-white p-3">
  <div class="shrink-0">
    <%= render "items/image",
               item: item,
               size_class: "h-16 w-16",
               image_class: "h-16 w-16 rounded-lg object-cover" %>
  </div>

  <div class="min-w-0 flex-1">
    <% if item.brand_name.present? %>
      <p class="truncate text-sm text-emerald-700"><%= item.brand_name %></p>
    <% end %>
    <h3 class="brand-font line-clamp-2 text-base font-bold text-slate-900">
      <%= link_to item.name, item_path(item), class: "transition hover:text-emerald-700" %>
    </h3>
  </div>

  <%= link_to edit_review_item_path(item),
              class: "inline-flex shrink-0 items-center gap-0.5 py-2 pl-2 text-sm font-semibold text-emerald-700 transition hover:text-emerald-900" do %>
    <%# スマホは商品名の場所を広く取るため「書く」だけにする %>
    <span class="hidden pc:inline">感想を</span>書く
    <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true"><path d="m9 6 6 6-6 6"></path></svg>
  <% end %>
</article>
