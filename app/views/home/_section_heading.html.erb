<%# ホームの各欄の見出し。icon でアイコンを選び、count があれば件数を、link_path があれば「すべて見る」を出す %>
<% count = local_assigns[:count] %>
<% link_path = local_assigns[:link_path] %>

<div class="flex items-center justify-between gap-3">
  <div class="flex items-center gap-2">
    <% case icon %>
    <% when :low_stock %>
      <svg class="h-5 w-5 text-amber-600" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 9v4"></path><path d="M12 17h.01"></path><path d="M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z"></path></svg>
    <% when :unreviewed %>
      <svg class="h-5 w-5 text-emerald-700" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 20h9"></path><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z"></path></svg>
    <% when :good %>
      <svg class="h-5 w-5 text-amber-500" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true"><path d="m12 3 2.7 5.6 6.1.9-4.4 4.3 1 6.1L12 17l-5.4 2.9 1-6.1-4.4-4.3 6.1-.9z"></path></svg>
    <% when :bad %>
      <svg class="h-5 w-5 text-red-700" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M8 15c1.2-1.3 2.5-2 4-2s2.8.7 4 2"></path><path d="M9 9.5h.01M15 9.5h.01"></path></svg>
    <% end %>
    <h2 class="brand-font text-lg font-bold text-slate-900"><%= title %></h2>
    <% if count&.positive? %>
      <span class="text-sm font-semibold text-slate-500"><%= count %></span>
    <% end %>
  </div>

  <% if link_path %>
    <%= link_to "すべて見る", link_path, class: "shrink-0 text-sm font-medium text-emerald-700 hover:underline" %>
  <% end %>
</div>
