<div class="ui-container-wide">
  <section>
    <h2 class="brand-font text-lg font-bold text-slate-900">なくなりそうなもの</h2>

    <% if @low_stock_items.any? %>
      <div class="mt-3 grid grid-cols-[repeat(auto-fill,minmax(170px,1fr))] gap-3 pc:grid-cols-[repeat(auto-fill,minmax(200px,1fr))]">
        <% @low_stock_items.each do |item| %>
          <%= render "item_card", item: item, show_rating: true %>
        <% end %>
      </div>

      <% if @low_stock_items_count > @low_stock_items.size %>
        <div class="mt-3 text-right">
          <%= link_to "もっと見る >>", items_path(low_stock: "1"), class: "text-sm font-medium text-emerald-700 hover:underline" %>
        </div>
      <% end %>
    <% else %>
      <p class="mt-3 py-16 text-center text-sm text-slate-500">なくなりそうなアイテムはありません</p>
    <% end %>
  </section>

  <section class="mt-8">
    <h2 class="brand-font text-lg font-bold text-slate-900">レビューをかいていないもの</h2>

    <% if @unreviewed_items.any? %>
      <div class="mt-3 grid grid-cols-[repeat(auto-fill,minmax(170px,1fr))] gap-3 pc:grid-cols-[repeat(auto-fill,minmax(200px,1fr))]">
        <% @unreviewed_items.each do |item| %>
          <%= render "item_card", item: item %>
        <% end %>
      </div>

      <% if @unreviewed_items_count > @unreviewed_items.size %>
        <div class="mt-3 text-right">
          <%= link_to "もっと見る >>", items_path(unreviewed: "1"), class: "text-sm font-medium text-emerald-700 hover:underline" %>
        </div>
      <% end %>
    <% else %>
      <p class="mt-3 py-16 text-center text-sm text-slate-500">レビュー未記入のアイテムがありません</p>
    <% end %>
  </section>

  <section class="mt-8">
    <div class="flex items-baseline justify-between">
      <h2 class="brand-font text-lg font-bold text-slate-900">よかったもの・イマイチだったもの</h2>
      <%= link_to "すべて見る", reviews_items_path, class: "text-sm font-medium text-emerald-700 hover:underline" %>
    </div>

    <div class="mt-3">
      <h3 class="text-base font-bold text-emerald-700">よかったもの</h3>

      <% if @good_items.any? %>
        <div class="mt-2 grid grid-cols-[repeat(auto-fill,minmax(260px,1fr))] gap-2.5">
          <% @good_items.each do |item| %>
            <%= render "items/review_card", item: item %>
          <% end %>
        </div>
      <% else %>
        <p class="mt-2 py-16 text-center text-sm text-slate-500">まだ高評価のアイテムがありません</p>
      <% end %>
    </div>

    <div class="mt-4">
      <h3 class="text-base font-bold text-red-700">イマイチだったもの</h3>

      <% if @bad_items.any? %>
        <div class="mt-2 grid grid-cols-[repeat(auto-fill,minmax(260px,1fr))] gap-2.5">
          <% @bad_items.each do |item| %>
            <%= render "items/review_card", item: item %>
          <% end %>
        </div>
      <% else %>
        <p class="mt-2 py-16 text-center text-sm text-slate-500">まだ低評価のアイテムがありません</p>
      <% end %>
    </div>
  </section>
</div>
