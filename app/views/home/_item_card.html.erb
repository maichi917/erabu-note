<%# ホームの「なくなりそうなもの」のカード。次も買うか決める材料として評価を出す。感想は詳細画面から書く %>
<article class="flex flex-col rounded-2xl border border-slate-200 bg-white p-3">
  <%= link_to item_path(item), class: "block" do %>
    <%= render "items/image",
               item: item,
               size_class: "aspect-square w-full",
               image_class: "aspect-square w-full rounded-lg object-cover" %>
    <% if item.brand_name.present? %>
      <p class="mt-2 truncate text-xs text-emerald-700"><%= item.brand_name %></p>
    <% end %>
    <h3 class="brand-font line-clamp-2 text-sm font-bold text-slate-900"><%= item.name %></h3>
  <% end %>

  <% if item.rating.present? %>
    <p class="mt-auto pt-1.5 text-sm font-semibold text-yellow-500"><%= star_rating(item.rating) %></p>
  <% end %>
</article>
