<% button_class =
  if item.low_stock_flagged?
    "border-amber-300 bg-amber-50 text-amber-800 hover:bg-amber-100"
  else
    "border-slate-200 bg-white text-slate-500 hover:border-amber-200 hover:bg-amber-50 hover:text-amber-700"
  end %>

<%= form_with url: toggle_low_stock_item_path(item), method: :patch, local: true, class: "inline-flex" do %>
  <button type="submit"
          aria-pressed="<%= item.low_stock_flagged? %>"
          class="inline-flex items-center justify-center rounded-full border px-3 py-1 text-xs font-semibold transition <%= button_class %>">
    なくなりそう
  </button>
<% end %>
