<div class="ui-container-wide">
  <%= render "shared/search_form",
             url: reviews_items_path,
             query: @search_query,
             hidden_params: {
               category_id: @selected_category_id.presence,
               rating: @selected_rating.presence
             },
             show_reset: @search_query.present?,
             reset_url: reviews_items_path(
               category_id: @selected_category_id.presence,
               rating: @selected_rating.presence
             ) %>

  <!-- selectのchangeイベントでフォームを送信すると、選ぶだけで絞り込めるドロップダウンになる -->
  <%= form_with url: reviews_items_path, method: :get, local: true, class: "mb-4 flex flex-wrap items-center gap-2", data: { controller: "auto-submit" } do %>
    <%= hidden_field_tag :q, @search_query.presence %>

    <%= render "items/category_select", categories: @categories, selected_category_id: @selected_category_id %>

    <select name="rating" data-action="auto-submit#submit" class="rounded-lg border border-slate-200 bg-white px-3 py-1.5 text-sm font-medium text-slate-600 shadow-sm focus:border-emerald-500 focus:outline-none focus:ring-2 focus:ring-emerald-100">
      <option value="">評価: すべて</option>
      <% 5.downto(1) do |rating| %>
        <option value="<%= rating %>" <%= "selected" if @selected_rating == rating.to_s %>>⭐️ <%= rating %></option>
      <% end %>
    </select>
  <% end %>

  <% if @items.any? %>
    <div class="grid grid-cols-[repeat(auto-fill,minmax(260px,1fr))] gap-2.5">
      <% @items.each do |item| %>
        <%= render "items/review_card", item: item, show_edit_link: true %>
      <% end %>
    </div>

    <div class="mt-8">
      <%= paginate @items %>
    </div>
  <% else %>
    <div class="ui-empty-state">
      <% if @search_query.present? %>
        <p class="text-lg">条件に合う評価・レビューがありません</p>
        <p class="mt-2 text-sm">検索条件を変更して、もう一度お試しください。</p>
        <%= link_to "検索条件をリセット", reviews_items_path, class: "btn-secondary mt-5" %>
      <% else %>
        <p class="text-lg">評価・レビューがありません</p>
        <p class="mt-2 text-sm">評価を残したアイテムがここに表示されます。</p>
      <% end %>
    </div>
  <% end %>
</div>
