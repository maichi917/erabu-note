<div>
  <span class="form-label">星評価（感想を書く場合は必須）</span>
  <div class="mt-1 flex gap-1" data-star-rating>
    <% (1..5).each do |n| %>
      <button type="button"
              class="text-2xl leading-none transition <%= n <= (form.object.rating || 0) ? "text-amber-400" : "text-slate-300 hover:text-amber-300" %>"
              data-star-rating-star
              data-value="<%= n %>"
              aria-label="星<%= n %>つ">★</button>
    <% end %>
  </div>
  <%= form.hidden_field :rating, data: { star_rating_input: true } %>
</div>
