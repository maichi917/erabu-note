<% full_width = local_assigns.fetch(:full_width, false) %>
<% button_class =
  if item.in_stock?
    "border-emerald-200 bg-emerald-50 text-emerald-700 hover:bg-emerald-100"
  else
    "border-slate-200 bg-white text-slate-500 hover:border-emerald-200 hover:bg-emerald-50 hover:text-emerald-700"
  end %>

<%= form_with url: toggle_stock_item_path(item), method: :patch, local: true, class: full_width ? "block" : "inline-flex" do %>
  <button type="submit"
          class="inline-flex items-center justify-center rounded-lg border px-3 py-1.5 text-sm font-semibold transition <%= button_class %> <%= full_width ? "w-full" : "" %>">
    <%= item.in_stock? ? "在庫あり" : "在庫なし" %>
  </button>
<% end %>
