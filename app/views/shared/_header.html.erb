<% share = user_signed_in? && share_area? %>
<% if user_signed_in? %>
  <%
    nav_items =
      if share
        [
          { name: :timeline, label: "タイムライン", path: share_timeline_path },
          { name: :search, label: "さがす", path: share_search_path },
          { name: :mypage, label: "マイページ", path: share_mypage_path }
        ]
      else
        [
          { name: :home, label: "ホーム", path: home_path },
          { name: :items, label: "持ち物", path: items_path },
          { name: :reviews, label: "感想", path: reviews_items_path },
          { name: :register, label: "登録", path: new_item_path }
        ]
      end
    room_link = share ? { name: :note, label: "ノートへ", path: home_path } : { name: :share, label: "シェア", path: share_timeline_path }
    # フォローしている人の新しい感想があれば、「シェア」に赤い点を出す
    new_shares = !share && current_user.new_shares?
  %>
<% end %>

<header class="border-b <%= share ? "border-rose-200" : "border-emerald-100" %> bg-white/95 shadow-sm">
  <div class="mx-auto flex w-full max-w-5xl items-center justify-between gap-3 px-4 py-4">
    <div class="flex min-w-0 items-center gap-2">
      <%= link_to root_path, class: "logo-font inline-flex shrink-0 items-center gap-2 text-2xl font-bold text-emerald-700 transition hover:text-emerald-800" do %>
        <%= image_tag "logo-mark.svg", alt: "", class: "h-8 w-8 shrink-0 pc:h-9 pc:w-9" %>
        <span class="whitespace-nowrap pc:text-3xl">えらぶノート</span>
      <% end %>
      <% if share %>
        <span class="inline-flex shrink-0 items-center gap-1 rounded-full bg-rose-50 py-0.5 pl-1.5 pr-2.5 text-xs font-bold text-rose-700 pc:pl-2 pc:pr-3 pc:text-base">
          <%= render "shared/nav_icon", name: :share, class: "h-4 w-4 shrink-0 pc:h-6 pc:w-6" %>シェア
        </span>
      <% end %>
    </div>

    <% if user_signed_in? %>
      <% if share %>
        <% active_nav_class = "border-b-2 border-rose-700 px-3 py-2 font-semibold text-rose-700" %>
        <% inactive_nav_class = "border-b-2 border-transparent px-3 py-2 font-medium text-slate-600 transition hover:border-slate-200 hover:text-rose-700" %>
        <% room_link_class = "border-b-2 border-transparent px-3 py-2 font-semibold text-emerald-700 transition hover:border-emerald-100" %>
      <% else %>
        <% active_nav_class = "border-b-2 border-emerald-600 px-3 py-2 font-semibold text-emerald-700" %>
        <% inactive_nav_class = "border-b-2 border-transparent px-3 py-2 font-medium text-slate-600 transition hover:border-slate-200 hover:text-emerald-700" %>
        <% room_link_class = "border-b-2 border-transparent px-3 py-2 font-medium text-slate-600 transition hover:border-rose-100 hover:text-rose-700" %>
      <% end %>

      <div class="flex items-center gap-4 pc:justify-end">
        <nav class="hidden items-center gap-1 self-stretch text-base pc:flex" aria-label="メインメニュー">
          <% nav_items.each do |nav| %>
            <%= link_to nav[:path], class: current_nav?(nav[:name]) ? active_nav_class : inactive_nav_class do %>
              <span class="inline-flex items-center gap-1.5">
                <%= render "shared/nav_icon", name: nav[:name], class: "h-4 w-4" %><%= nav[:label] %>
              </span>
            <% end %>
          <% end %>
          <span class="mx-1 h-5 w-px self-center bg-slate-200" aria-hidden="true"></span>
          <%= link_to room_link[:path], class: room_link_class do %>
            <span class="inline-flex items-center gap-1.5">
              <span class="relative">
                <%= render "shared/nav_icon", name: room_link[:name], class: "h-4 w-4" %>
                <% if new_shares %><span class="absolute -right-1 -top-1 h-2 w-2 rounded-full bg-rose-600" aria-label="新着あり"></span><% end %>
              </span><%= room_link[:label] %>
            </span>
          <% end %>
        </nav>

        <!-- detailsタグは、ブラウザ標準の「クリックで開閉する箱」の機能。JS不要でドロップダウンを作れる -->
        <details class="relative">
          <summary class="btn-secondary inline-flex cursor-pointer list-none px-3 py-1.5 [&::-webkit-details-marker]:hidden">
            <%= current_user.name %>
          </summary>

          <div class="absolute right-0 z-10 mt-2 w-40 rounded-lg border border-slate-200 bg-white py-1 shadow-lg">
            <%# ゲストはアカウント情報を変更できないため、編集リンクは表示しない %>
            <% unless current_user.guest? %>
              <%= link_to "アカウント編集", edit_user_registration_path, class: "block px-4 py-2 text-sm text-slate-700 transition hover:bg-slate-50" %>
            <% end %>
            <%# PCではフッターに表示されるため、ヘッダーにはスマホ幅でだけ表示する %>
            <div class="pc:hidden">
              <%= link_to "利用規約", terms_path, class: "block whitespace-nowrap px-4 py-2 text-xs text-slate-700 transition hover:bg-slate-50" %>
              <%= link_to "プライバシーポリシー", privacy_path, class: "block whitespace-nowrap px-4 py-2 text-xs text-slate-700 transition hover:bg-slate-50" %>
              <%= link_to "お問い合わせ", contact_path, class: "block whitespace-nowrap px-4 py-2 text-xs text-slate-700 transition hover:bg-slate-50" %>
            </div>
            <%= link_to "ログアウト", destroy_user_session_path, data: { turbo_method: :delete }, class: "block px-4 py-2 text-sm text-slate-700 transition hover:bg-slate-50" %>
          </div>
        </details>
      </div>
    <% else %>
      <nav class="flex shrink-0 items-center gap-2 whitespace-nowrap text-sm text-slate-700 pc:gap-3" aria-label="アカウント">
        <%= link_to "新規登録", new_user_registration_path, class: "py-2 hover:text-emerald-700" %>
        <span class="text-slate-300" aria-hidden="true">|</span>
        <%= link_to "ログイン", new_user_session_path, class: "py-2 hover:text-emerald-700" %>
      </nav>
    <% end %>
  </div>
</header>

<% if user_signed_in? %>
  <% tab_class = "flex min-w-0 flex-1 flex-col items-center gap-0.5 whitespace-nowrap rounded-md py-2.5 font-medium" %>
  <% active_tab_color = share ? "text-rose-700" : "text-emerald-700" %>
  <% room_tab_color = share ? "text-emerald-700" : "text-slate-500" %>

  <nav class="fixed inset-x-0 bottom-0 z-20 flex gap-1 border-t <%= share ? "border-rose-200" : "border-emerald-100" %> bg-white/95 px-2 py-2 text-center text-sm shadow-[0_-1px_4px_rgba(0,0,0,0.06)] pc:hidden" aria-label="スマートフォンメニュー">
    <% nav_items.each do |nav| %>
      <%= link_to nav[:path], class: "#{tab_class} #{current_nav?(nav[:name]) ? active_tab_color : "text-slate-500"}" do %>
        <%= render "shared/nav_icon", name: nav[:name], class: "h-5 w-5" %>
        <span><%= nav[:label] %></span>
      <% end %>
    <% end %>
    <span class="my-1 w-px shrink-0 bg-slate-200" aria-hidden="true"></span>
    <%= link_to room_link[:path], class: "#{tab_class} #{room_tab_color}" do %>
      <span class="relative">
        <%= render "shared/nav_icon", name: room_link[:name], class: "h-5 w-5" %>
        <% if new_shares %><span class="absolute -right-1 -top-1 h-2.5 w-2.5 rounded-full bg-rose-600" aria-label="新着あり"></span><% end %>
      </span>
      <span><%= room_link[:label] %></span>
    <% end %>
  </nav>
<% end %>
