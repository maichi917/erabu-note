    <%# ログイン時は、スマホ幅でだけ非表示にする（ヘッダーのアカウントメニューに移す）。PCでは常に表示する %>
    <nav class="mb-3 flex-wrap justify-center gap-x-5 gap-y-2 text-sm <%= user_signed_in? ? "hidden pc:flex" : "flex" %>">
