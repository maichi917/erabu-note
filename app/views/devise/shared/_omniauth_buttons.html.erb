<% if devise_mapping.omniauthable? %>
  <div class="space-y-2">
    <% action_label = controller_name == "registrations" ? "登録する" : "ログインする" %>
    <%- resource_class.omniauth_providers.each do |provider| %>
      <% provider_label = provider == :line ? "LINE" : OmniAuth::Utils.camelize(provider) %>
      <%= button_to "#{provider_label}で#{action_label}", omniauth_authorize_path(resource_name, provider), class: "btn-secondary w-full cursor-pointer", data: { turbo: false } %>
    <% end %>
  </div>
<% end %>
