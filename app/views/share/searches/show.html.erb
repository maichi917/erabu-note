<div class="ui-container-wide space-y-4">
  <h1 class="brand-font text-lg font-bold text-slate-900">さがす</h1>

  <%= form_with url: share_search_path, method: :get, local: true do %>
    <div class="flex max-w-md items-center gap-2">
      <%= search_field_tag :q, @query, placeholder: "商品名でさがす", class: "form-input h-10", autocomplete: "off" %>
      <%= button_tag type: "submit", class: "btn-secondary h-10 w-10 shrink-0 p-0", aria: { label: "さがす" } do %>
        <%= render "shared/nav_icon", name: :search, class: "h-5 w-5" %>
      <% end %>
    </div>
  <% end %>

  <% if @query.present? %>
    <p class="text-sm text-slate-500">「<%= @query %>」の感想 <%= @items.total_count %>件・新しい順</p>
  <% end %>

  <% if @items.any? %>
    <div class="grid grid-cols-1 gap-2.5 pc:grid-cols-2">
      <%= render partial: "share/review_card", collection: @items, as: :item, locals: { show_user: true } %>
    </div>
    <%= paginate @items %>
  <% else %>
    <p class="py-10 text-center text-sm text-slate-500">シェアされた感想は見つかりませんでした。</p>
  <% end %>
</div>
