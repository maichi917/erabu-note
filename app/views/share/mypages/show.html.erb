<%= render "share/profile_header", user: current_user, items_count: @items.size, editable: true %>
<%= render "share/mypage_tabs" %>

<div class="ui-container-wide">
  <% if @items.any? %>
    <div class="grid grid-cols-1 gap-2.5 pc:grid-cols-2">
      <%= render partial: "share/review_card", collection: @items, as: :item %>
    </div>
  <% else %>
    <p class="py-10 text-center text-sm text-slate-500">シェア中の感想はまだありません。感想を書くときの「シェアする」から、シェアできます。</p>
  <% end %>
</div>
