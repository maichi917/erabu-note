<%# シェアの画面の感想カード。他のユーザーに見せてよい項目（画像・ブランド・商品名・星・感想・手放したか）だけを出す。
    show_user: true で、書いた人の名前（プロフィールへのリンク）を上に出す %>
<% show_user = local_assigns.fetch(:show_user, false) %>

<article class="space-y-2.5 rounded-2xl border border-slate-200 bg-white p-3">
  <% if show_user %>
    <%= link_to share_user_path(item.user), class: "flex items-center gap-2 text-sm font-bold text-slate-900 transition hover:text-rose-700" do %>
      <%= render "share/avatar", user: item.user, class: "h-7 w-7", icon_class: "h-4 w-4" %>
      <%= item.user.name %>
    <% end %>
  <% end %>

  <div class="flex gap-3">
    <div class="shrink-0">
      <%= render "items/image",
                 item: item,
                 size_class: "h-16 w-16",
                 image_class: "h-16 w-16 rounded-lg object-cover" %>
    </div>

    <div class="min-w-0 flex-1">
      <% if item.brand_name.present? %>
        <p class="truncate text-sm text-emerald-700"><%= item.brand_name %></p>
      <% end %>
      <h3 class="brand-font text-base font-bold text-slate-900">
        <%= item.name %>
        <% if item.archived? %>
          <span class="ml-1 rounded bg-slate-100 px-1.5 py-0.5 text-xs font-bold text-slate-500">手放した</span>
        <% end %>
      </h3>
      <p class="mt-0.5 text-sm font-semibold text-yellow-500"><%= star_rating(item.rating) %></p>
      <% if item.review.to_s.length > 100 %>
        <%# 長い感想は、はじめだけ見せて「続きを読む」で開く %>
        <details class="group mt-0.5 text-sm text-slate-600">
          <summary class="cursor-pointer list-none [&::-webkit-details-marker]:hidden">
            <span class="group-open:hidden"><%= item.review.first(100) %>… <span class="font-semibold text-rose-700">続きを読む</span></span>
          </summary>
          <p class="whitespace-pre-wrap"><%= item.review %></p>
        </details>
      <% elsif item.review.present? %>
        <p class="mt-0.5 whitespace-pre-wrap text-sm text-slate-600"><%= item.review %></p>
      <% end %>
    </div>
  </div>
</article>
